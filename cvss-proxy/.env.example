# Fleet CVSS Proxy environment example
# Copy to .env and replace values for your lab.
# Do not commit real credentials or private CA/key material.

# NVD API used to enrich Fleet CVE webhook payloads.
# NVD_API_KEY is optional, but recommended to avoid low anonymous rate limits.
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
CACHE_TTL_SECONDS=86400

# PacketFence endpoint that receives the enriched Fleet CVE event.
# This should be the PacketFence FleetDM CVE webhook/API URL.
PACKETFENCE_URL=https://packetfence.example:9999/api/v1/fleetdm-events/cve

# TLS verification for PacketFence.
# Use true with PACKETFENCE_CA_FILE mounted into the container.
# PACKETFENCE_CA_FILE_HOST is the host-side path used by compose.example.yaml.
# Set PACKETFENCE_VERIFY_TLS=false only for temporary lab debugging.
PACKETFENCE_VERIFY_TLS=true
PACKETFENCE_CA_FILE=/etc/ssl/packetfence/ca.crt
PACKETFENCE_CA_FILE_HOST=../packetfence-lab-ca.crt

# PacketFence API credentials.
# Option A: set credentials directly here for local testing only.
PACKETFENCE_USER=watcher-recovery
PACKETFENCE_PASSWORD=replace-with-packetfence-api-password

# Option B: preferred in Docker Compose: mount a secret file and point here.
# The file may contain either PACKETFENCE_USER/PACKETFENCE_PASSWORD or
# PF_RECOVERY_USER/PF_RECOVERY_PASSWORD.
PF_CREDENTIAL_FILE=/run/secrets/pf-recovery-env
