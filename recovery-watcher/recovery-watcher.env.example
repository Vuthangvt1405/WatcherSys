# Fleet/PacketFence Recovery Watcher runtime environment example
# Copy to recovery-watcher.env for local/docker testing, or map these values into compose.example.yaml.
# Do not commit real credentials, passwords, private keys, or runtime state.

# Fleet MySQL connection
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=fleet
MYSQL_USER=fleet

# Use exactly one of MYSQL_PASSWORD or MYSQL_PASSWORD_FILE.
# Docker Compose secret default: /run/secrets/mysql-password
MYSQL_PASSWORD_FILE=/run/secrets/mysql-password
# MYSQL_PASSWORD=replace-with-fleet-mysql-password

# Optional MySQL TLS CA mounted inside the container.
MYSQL_SSL_CA=/etc/ssl/fleet/mysql-ca.pem

# Fleet recovery checks
# POLICY_ID is the Fleet policy that should transition fail -> pass.
POLICY_ID=2

# CVE_REGEX selects CVEs that should transition vulnerable -> clean.
CVE_REGEX=^CVE-2018-10115$

# PacketFence event IDs to close after recovery.
PF_SECURITY_EVENT_ID=3500001
PF_CVE_SECURITY_EVENT_ID=3500002

# PacketFence API
PF_BASE_URL=https://packetfence.example:9999
PF_CA_FILE=/etc/ssl/packetfence/ca.crt
PF_ALLOW_LEGACY_CA=false
PF_TIMEZONE=America/New_York

# PacketFence credentials secret file.
# File must contain:
# PF_RECOVERY_USER=watcher-recovery
# PF_RECOVERY_PASSWORD=replace-with-packetfence-api-password
PF_CREDENTIAL_FILE=/run/secrets/pf-recovery-env

# Persistent state file. Keep this on a volume so baseline/recovery state survives restarts.
STATE_FILE=/var/lib/fleet-recovery/state.json

# Poll interval in seconds.
POLL_SECONDS=2
